# Copy to `backend/.env` — that is the path docker-compose.yml names in
# `env_file`, and `make start` creates it from this file automatically.
# (A separate root `.env` is optional and does something different: compose
# reads only FRONTEND_PORT and OLLAMA_BASE_URL from there, for `${...}`
# substitution inside docker-compose.yml itself.)
# Every key below is read by the code; nothing here is aspirational.
# Only the provider keys are required — everything else has a working default
# and exists to be tuned, so an empty .env with three real keys runs the stack.

# ── Providers (required) ─────────────────────────────────────────────────────
# litellm reads these from the environment directly, by provider convention,
# rather than through os.getenv in this codebase — which is why grepping the
# source for them finds nothing.
GEMINI_API_KEY=your_key_here
GROQ_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here

# ── Providers (optional) ─────────────────────────────────────────────────────
# Third cloud fallback tier, used only after Groq/Gemini/OpenRouter are all
# exhausted. litellm's nvidia_nim provider actually reads NVIDIA_NIM_API_KEY —
# llm_router.py bridges this key to that name at load time, so set this one
# rather than that one. Free tier is credit-based, not a renewing daily quota
# like Groq/Gemini's — it can eventually need billing once credits run out.
NVIDIA_API_KEY=your_key_here

# ── Provider expansion (2026-08-11) ──────────────────────────────────────────
# Free-tier providers added to widen the pool behind Groq, whose 100k tokens/day
# is the constraint that actually binds this project. All three are supported
# natively by the installed litellm (1.83.9) via a `<provider>/<model>` prefix,
# so they need no adapter code — see docs/PROVIDER_EXPANSION.md for the dated
# verification record, including what is verified and what is not.
#
# EACH KEY IS OPTIONAL AND INDEPENDENT. An unset key means that provider
# contributes nothing to any chain, exactly as NVIDIA/OpenRouter already
# behave — no error, no dead round trip, and it shows as inactive in
# docs/PROVIDERS.md and the metrics panel.
#
# NOTE: a key alone does NOT put a provider into rotation. No model routes
# traffic without a row in the probed capability matrix (config/model_capabilities.json).
# Add the key, then run: venv/bin/python scripts/probe_models.py

# Cerebras — https://cloud.cerebras.ai (no credit card)
# The biggest verified win: the Free Trial tier is 1M tokens/day PER MODEL
# against Groq's 100k/day total, and covers the whole public model catalogue.
# The real constraint is 5 RPM, not the token ceiling — one call per 12s, which
# is why it is depth BEHIND Groq rather than a replacement for the parallel
# coder phase. Pace it with LLM_MIN_INTERVAL_CEREBRAS (see below).
CEREBRAS_API_KEY=your_key_here

# DeepSeek — https://platform.deepseek.com
# UNVERIFIED: a "5M free tokens on signup" grant is widely reported but appears
# nowhere in DeepSeek's own docs, which describe concurrency limits only and no
# free tier. Check the console credit balance after signing up before relying
# on it. Its live model slugs are deepseek-v4-pro / deepseek-v4-flash; litellm
# maps the OLDER deepseek-chat / deepseek-reasoner, so confirm against the live
# catalogue rather than trusting the mapping.
DEEPSEEK_API_KEY=your_key_here

# Mistral — https://console.mistral.ai (free "Experiment" tier, no card)
# UNVERIFIED: reported as ~1B tokens/month at 2 RPM, but Mistral no longer
# publishes free-tier numbers publicly. Read your actual ceiling from
# Admin Console -> Limits and set LLM_DAILY_TOKENS_MISTRAL accordingly.
# Adding a billing card silently upgrades the account off the free tier.
MISTRAL_API_KEY=your_key_here

# ── Observability (Day 23) ───────────────────────────────────────────────────
# Local metrics (metrics.db) are always recorded and need no keys — they power
# the in-app metrics panel and the Day 26 token analysis.
#
# LangSmith is OPTIONAL and only adds the interactive trace dashboard. It stays
# off unless BOTH lines below are real: tracing is skipped while the API key is
# still the literal "your_key_here" placeholder, so an unconfigured checkout
# never emits 403s on every call. Get a key at https://smith.langchain.com.
LANGCHAIN_API_KEY=your_key_here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=multiagent-builder

# Master switch — set false to disable BOTH tracing and local metrics
# (used for clean latency benchmarking and offline work).
OBSERVABILITY_ENABLED=true

# ── Generation (Day 20/21) ───────────────────────────────────────────────────
# Coder agents run files in parallel by default. Set to `sequential` to force
# one-at-a-time — the reliable way to read a confusing run's logs in order.
GENERATION_MODE=parallel
# Worker count for parallel generation. Unset uses the built-in default; lower
# it if a provider starts returning 429s faster than the pacer absorbs them.
# GENERATION_MAX_CONCURRENT=3

# ── Validation & repair (Day 17/22) ──────────────────────────────────────────
# Minimum score a generated project must reach before QA stops flagging it.
QUALITY_THRESHOLD=0.2
# Paid LLM repairs are capped twice: per file, and per whole run. Both exist so
# one pathological file cannot consume a day's quota.
#
# ONE ACCOUNT: these cover Day 22's repairs AND Improvement 01's reviewer
# revisions together. A revision is an LLM call that fixes a generated file,
# which is what a repair is, so it charges the same per-file key. There is
# deliberately no separate review budget — two counters over one ceiling is how
# a file quietly ends up spending 2 repairs plus 2 revisions.
#
# The run ceiling was raised 10 -> 14 for exactly that reason: revisions land
# inside the coder phase, so at 10 a review-heavy frontend phase could exhaust
# the budget before the validation pass ran at all. Exhaustion remains a
# DIAGNOSTIC — a run needing this many repairs has a prompt or architecture
# problem, and raising the ceiling to silence it is the anti-pattern.
REPAIR_CAP_PER_FILE=2
REPAIR_CEILING_PER_RUN=14

# ── Frontend decomposition & review (Improvement 01) ─────────────────────────
# BOTH DEFAULT TO OFF, so out of the box this is exact v1.0 behaviour: the
# planner is not sent the decomposition spec, the plan validator stands down, no
# review call is made, no review event is broadcast.
#
# Off is not a doubt about the code — it is the pre-registered keep/revert rule
# being honoured. That rule required a measured frontend-quality gain, and the
# A/B needs ~460k tokens across two full pipeline runs against a groq allowance
# of 100k/day, so it could not run (docs/IMPROVEMENT_01_RESULTS.md Task 6). The
# feature is complete and tested; it is UNPROVEN, and unproven does not get to be
# the default. Turn both on to measure it.
#
# Split large frontend pages into section-level component tasks plus a thin page
# shell, so each generation call gets a small precise job instead of a whole
# screen. Sections are bounded 2-5 per page: one is not a decomposition, six is
# atomisation and each one costs a whole call.
DECOMPOSE_FRONTEND=false
# Minimum estimated_complexity at which a PAGE is worth decomposing (low |
# medium | high). Only pages and App.jsx are ever candidates. Widen to `medium`
# to decompose more aggressively — and expect proportionally more calls.
DECOMPOSE_COMPLEXITY_THRESHOLD=high

# A reviewer agent judges a generated frontend file against its spec and returns
# a structured verdict; a failing file gets exactly ONE targeted revision.
#   off        no review at all — v1.0 behaviour
#   selective  page shells, shared primitives, files with validation warnings,
#              and high-complexity tasks (~a quarter of a file set)
#   all        every frontend file — expensive, for measurement only
# The reviewer is routed to gemini (frontend_review in llm_router.MODELS), NOT
# to the coders' groq primary, so review does not compete with generation for
# the pool that actually binds. Fast mode withholds review entirely, exactly as
# it withholds repairs.
REVIEW_MODE=off

# ── LLM cache (Day 26) ───────────────────────────────────────────────────────
# Content-addressed response cache in metrics.db. Set false to force every call
# to hit the provider — needed when A/B testing a prompt change, since a cache
# hit would otherwise return the OLD prompt's answer.
LLM_CACHE=true

# ── Rate limiting & budgets (Day 26) ─────────────────────────────────────────
# These three are DYNAMIC keys — the suffix is interpolated at lookup, so they
# do not appear literally in the source.
#
#   LLM_MAX_TOKENS_{AGENT}     per-agent output cap, e.g. LLM_MAX_TOKENS_QA
#   LLM_MIN_INTERVAL_{PROVIDER} seconds between calls, e.g. LLM_MIN_INTERVAL_GROQ
#   LLM_DAILY_TOKENS_{PROVIDER} tokens/day ceiling, e.g. LLM_DAILY_TOKENS_GROQ
#
# All are optional overrides of the built-in defaults in llm_router.py. The
# daily one is the limit that actually halts work on free tiers — Groq's
# 100k/day is reached long before any per-minute limit bites.
# LLM_MAX_TOKENS_QA=8000
# LLM_MIN_INTERVAL_GROQ=2.0
# LLM_DAILY_TOKENS_GROQ=100000

# Cerebras needs the pacing key more than any other provider: its free tier is
# 5 RPM, so calls must be ~12s apart, and the coders run 3 parallel workers.
# Without this the workers spend their attempts on 429s the moment they fail
# over together. Existing pacer doing its job — not a new mechanism.
# LLM_MIN_INTERVAL_CEREBRAS=12.0
#
# Cerebras' 1M/day allowance is PER MODEL, but the budget tracker counts per
# PROVIDER. Tracking one provider-wide 1M therefore understates real capacity
# while never overspending it, which is the safe direction to be wrong in.
# LLM_DAILY_TOKENS_CEREBRAS=1000000

# One more, NVIDIA-specific rather than a generic {PROVIDER} key: its rate
# limit is a rolling ~10-15 minute cooldown, not a daily allowance, so it gets
# its own timestamp-based mechanism instead of LLM_DAILY_TOKENS_NVIDIA_NIM.
# LLM_COOLDOWN_MINUTES_NVIDIA_NIM=12

# ── Local models / Ollama (Day 29) ───────────────────────────────────────────
# Where the Ollama daemon is. Host install during development; the compose
# `ollama` profile service (`docker compose --profile ollama up`) reaches it at
# http://ollama:11434 instead. Probed with a 1s timeout — if nothing answers,
# the local tier is skipped and the chain behaves exactly as it did before.
# No key, no quota: this tier exists so a spent cloud budget stops being fatal.
OLLAMA_BASE_URL=http://localhost:11434

# How the tier chain is ordered:
#   auto         cloud primary -> cloud fallback -> local  (default)
#   cloud-only   never use local; pause instead of degrading — for a final build
#   prefer-local local first, cloud still behind it — free unlimited iteration
LLM_MODE=auto

# Concurrent LOCAL calls. Deliberately far below the cloud concurrency: local
# models contend for one machine's RAM and GPU, so past this they get SLOWER
# than running serially, and two ~5GB models cannot be resident at once on 8GB.
# This is a hardware limit, not a rate limit. Raise it if the machine has room.
OLLAMA_MAX_CONCURRENT=1

# Largest context window a local model may be given, in tokens. The router
# sizes each local call to its own prompt + output, because ollama otherwise
# defaults every model to 4,096 tokens and SILENTLY TRUNCATES anything larger —
# this pipeline's prompts are 11-15k characters, so more than half of each one
# was being discarded with no error (Day 30). This ceiling exists only because
# the KV cache is real memory; raise it on a machine with headroom.
# OLLAMA_MAX_CONTEXT_TOKENS=16384

# ── Testing only ─────────────────────────────────────────────────────────────
# Deliberately corrupts agent output to exercise the validation/repair paths.
# Leave EMPTY in normal use. Values: syntaxerr, truncate, empty.
FAULT_INJECTION=
